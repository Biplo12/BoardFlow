# Convex. `npx convex dev` writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL
# for you the first time you run it against your own project.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=http://localhost:3000

# Liveblocks. The secret key signs the room session in
# app/api/liveblocks-auth/route.ts and must never reach the browser.
LIVEBLOCKS_SECRET_KEY=

# Optional: prints the client logger in production builds.
NEXT_PUBLIC_SHOW_LOGGER=false

# Only needed to run the one-off Clerk import in convex/migrations.ts. Leave
# it empty unless you are migrating an existing Clerk workspace.
CLERK_SECRET_KEY=

# Auth providers live on the Convex deployment, not here. Set them with
# `npx convex env set NAME value`:
#   SITE_URL                 http://localhost:3000
#   JWT_PRIVATE_KEY          generated by `npx @convex-dev/auth`
#   JWKS                     generated by `npx @convex-dev/auth`
#   AUTH_GOOGLE_ID           optional, for "Continue with Google"
#   AUTH_GOOGLE_SECRET
#   AUTH_GITHUB_ID           optional, for "Continue with GitHub"
#   AUTH_GITHUB_SECRET
#   AUTH_RESEND_KEY          optional, for magic-link sign-in
